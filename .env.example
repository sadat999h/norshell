# ── Database, storage, and auth — all Supabase, same project ─────────────────
#
# NOTE: none of these are required for the initial Vercel deploy. Admin
# login is currently disabled and /admin is open with no auth, and the
# storefront runs fine with an empty catalog when DATABASE_URL is unset.
# Add these back (and re-enable adminProcedure / the login screen) when
# you're ready to connect Supabase.

# Postgres connection string for your Supabase project. Find it in
# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction pooler" connection (port 6543) when deploying to
# Vercel or any other serverless platform — it's pooled for many short-lived
# connections, unlike the direct connection (port 5432).
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Server-side Supabase client (image storage + verifying auth tokens).
# From Supabase → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side Supabase client (exposed to the browser — use the anon/public
# key, NOT the service role key). Same project, VITE_-prefixed so Vite
# exposes them to the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The email address that is automatically granted the "admin" role the first
# time it signs in. Create this user in Supabase Auth (Authentication → Users
# → Add user) with a password, then set this to that same email.
ADMIN_EMAIL=you@example.com
